<section id="features" class="py-16 px-6 max-w-4xl mx-auto">
  <h2 class="text-xl font-semibold text-zinc-100 mb-8 text-center">
    Everything you need to reclaim disk space
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
    <div class="border border-zinc-800/80 rounded-xl p-5 bg-zinc-950/40">
      <div class="text-zinc-200 font-medium text-sm mb-1">
        Multi-Ecosystem Support
      </div>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Targets not just JavaScript (<code class="font-mono text-zinc-300"
          >node_modules</code
        >, <code class="font-mono text-zinc-300">.next</code>), but also Python
        (<code class="font-mono text-zinc-300">.venv</code>, <code
          class="font-mono text-zinc-300">__pycache__</code
        >), Rust (<code class="font-mono text-zinc-300">target</code>), Gradle,
        and Go.
      </p>
    </div>
    <div class="border border-zinc-800/80 rounded-xl p-5 bg-zinc-950/40">
      <div class="text-zinc-200 font-medium text-sm mb-1">
        Collapsible Tree UI & Themes
      </div>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Navigate smoothly with a rich terminal interface. Customize your setup
        with themes like Catppuccin, One Dark, Dracula, and Gruvbox.
      </p>
    </div>
    <div class="border border-zinc-800/80 rounded-xl p-5 bg-zinc-950/40">
      <div class="text-zinc-200 font-medium text-sm mb-1">
        Age Filters & Dry Runs
      </div>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Filter directories untouched for months using <code
          class="font-mono text-zinc-300">--older-than 90d</code
        > or preview cleanups safely via <code class="font-mono text-zinc-300"
          >--dry-run</code
        >.
      </p>
    </div>
    <div class="border border-zinc-800/80 rounded-xl p-5 bg-zinc-950/40">
      <div class="text-zinc-200 font-medium text-sm mb-1">
        History & Reports
      </div>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Keep track of your freed space over time, view past cleanup statistics,
        and export detailed JSON or CSV session reports.
      </p>
    </div>
  </div>

  <!-- Sección de Opciones / CLI Reference -->
  <div class="border border-zinc-800/80 rounded-xl p-6 bg-zinc-950/40">
    <h3 class="text-sm font-mono text-zinc-200 mb-4 uppercase tracking-wider">
      Command-Line Options
    </h3>
    <div class="space-y-3 font-mono text-xs">
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-2 pb-2 border-b border-zinc-900"
      >
        <span class="text-zinc-200 font-medium">path</span>
        <span class="text-zinc-400 md:col-span-2"
          >Root directory to scan (default: current dir)</span
        >
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-2 pb-2 border-b border-zinc-900"
      >
        <span class="text-zinc-200 font-medium">--max-depth N</span>
        <span class="text-zinc-400 md:col-span-2">Limit recursion depth</span>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-2 pb-2 border-b border-zinc-900"
      >
        <span class="text-zinc-200 font-medium">--no-size</span>
        <span class="text-zinc-400 md:col-span-2"
          >Skip size measurement for instant listings</span
        >
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-2 pb-2 border-b border-zinc-900"
      >
        <span class="text-zinc-200 font-medium">--older-than X</span>
        <span class="text-zinc-400 md:col-span-2"
          >Only target folders untouched for X (e.g. 90d, 6m, 1y)</span
        >
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-2 pb-2 border-b border-zinc-900"
      >
        <span class="text-zinc-200 font-medium">--dry-run</span>
        <span class="text-zinc-400 md:col-span-2"
          >Simulate removal without deleting files</span
        >
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-2 pb-2 border-b border-zinc-900"
      >
        <span class="text-zinc-200 font-medium">--report FILE</span>
        <span class="text-zinc-400 md:col-span-2"
          >Export a JSON or CSV report of the session</span
        >
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-2 pb-2 border-b border-zinc-900"
      >
        <span class="text-zinc-200 font-medium">--theme NAME</span>
        <span class="text-zinc-400 md:col-span-2"
          >UI color theme (one-dark, catppuccin, dracula…)</span
        >
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
        <span class="text-zinc-200 font-medium">--history / --stats</span>
        <span class="text-zinc-400 md:col-span-2"
          >Show past cleanups and aggregate statistics</span
        >
      </div>
    </div>
  </div>
</section>
