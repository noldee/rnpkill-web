---
interface Props {
  gifSrc?: string;
}

const {
  gifSrc = "https://media2.giphy.com/media/v1.Y2lkPTZjMDliOTUyNTRheG5iNWVrMm8yYmw0ZGE3NTNpYndzejEzMWR3a3BieTZhZTlnayZlcD12MV9naWZzX3NlYXJjaCZjdD1n/26tn33aiTi1jkl6H6/giphy.gif",
} = Astro.props;
---

<section class="py-10 px-6 max-w-3xl mx-auto">
  <div
    class="border border-zinc-800 rounded-xl bg-zinc-950 overflow-hidden shadow-2xl"
  >
    <div
      class="px-4 py-3 bg-zinc-900/80 border-b border-zinc-800 flex items-center justify-between"
    >
      <div class="flex items-center gap-1.5">
        <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
        <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
        <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
      </div>
      <span class="text-xs font-mono text-zinc-400">rnpkill-rs demo</span>
      <div class="w-10"></div>
    </div>

    <div class="bg-black">
      <img
        src={gifSrc}
        alt="rnpkill-rs demo in action"
        class="w-full h-auto block object-cover"
        loading="lazy"
      />
    </div>
  </div>
</section>
